<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/Primary">

    <ListView
        android:id="@+id/list_name"
        android:layout_width="280dp"
        android:layout_height="350dp"
        android:background="@color/Secondary"
        app:flow_horizontalAlign="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/popular" />


    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_lecture"
        style="@style/CustomButtonStyle"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="364dp"
        android:onClick="add_file"
        android:text="Загрузить лекцию"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/list_name" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/back"
        style="@style/CustomButtonStyle"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="412dp"
        android:onClick="back"
        android:text="Назад"
        android:textColor="@color/black"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/list_name" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/find_lecture"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:onClick="find_lecture"
        style="@style/CustomButtonStyle"
        android:textColor="@color/black"
        android:text="Загрузить материал"
        app:flow_horizontalAlign="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/find_course" />

    <EditText
        android:id="@+id/name_lecture_find"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:ems="10"
        android:textColor="@color/black"
        android:hint="Название материала"
        android:textColorHint="@color/Maroon"
        android:inputType="text"
        android:textSize="16dp"
        app:flow_horizontalAlign="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Spinner
        android:id="@+id/typeObject_find"
        android:layout_width="280dp"
        android:layout_height="35dp"
        android:layout_marginTop="16dp"
        android:popupTheme="@style/SpinnerStyle"
        app:flow_horizontalAlign="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/name_lecture_find" />

    <EditText
        android:id="@+id/find_course"
        android:layout_width="280dp"
        android:layout_height="40dp"
        android:layout_marginTop="16dp"
        android:ems="10"
        android:hint="Курс"
        android:textColor="@color/black"
        android:inputType="number"
        android:textColorHint="@color/Maroon"
        android:textSize="16dp"
        app:flow_horizontalAlign="center"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/typeObject_find" />

    <CheckBox
        android:id="@+id/popular"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Отсортировать по популярности"
        android:textColor="@color/black"
        android:textSize="15dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/find_lecture" />

    <ImageView
        android:id="@+id/del_old"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:visibility="invisible"
        android:onClick="del_old"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/baseline_archive_24" />

</androidx.constraintlayout.widget.ConstraintLayout>